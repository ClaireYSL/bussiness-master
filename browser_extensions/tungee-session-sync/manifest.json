{
  "manifest_version": 3,
  "name": "探迹会话同步器",
  "version": "0.1.6",
  "description": "从当前浏览器的探迹登录态同步 cookies 和 x-tonxis 请求头到本地商机线索引擎。",
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://sales.tungee.com/*",
    "https://user.tungee.com/*",
    "https://*.tungee.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/console*",
    "https://*/console*",
    "http://*/tungee/connect*",
    "https://*/tungee/connect*",
    "http://*/api/tungee/session/*",
    "https://*/api/tungee/session/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://*/console*",
        "https://*/console*",
        "http://*/tungee/connect*",
        "https://*/tungee/connect*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sales.tungee.com/*"
      ],
      "js": ["sales-capture-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sales.tungee.com/*"
      ],
      "js": ["sales-capture-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "同步探迹会话",
    "default_popup": "popup.html"
  }
}
