# 基础应用配置
APP_ENV=production
APP_NAME=business-leads-engine
APP_SECRET_KEY=replace-with-a-long-random-string
AUTH_COOKIE_NAME=bussiness_auth
ADMIN_GATE_COOKIE_NAME=bussiness_admin_gate
AUTH_SESSION_DAYS=7

# 镜像与端口
APP_IMAGE=business-leads-engine:latest
APP_PORT=8000
APP_SECURITY_OPT=seccomp=unconfined
PYTHON_BASE_IMAGE=docker.1ms.run/python:3.11-slim
POSTGRES_IMAGE=docker.1ms.run/postgres:16-alpine
REDIS_IMAGE=docker.1ms.run/redis:7-alpine
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# PostgreSQL
POSTGRES_DB=business_leads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-password@postgres:5432/business_leads

# Redis
REDIS_URL=redis://redis:6379/0

# 外部服务
TUNGEE_BASE_URL=https://user.tungee.com
TUNGEE_SALES_BASE_URL=https://sales.tungee.com
TUNGEE_TIMEOUT_SECONDS=20
TUNGEE_SESSION_TTL_HOURS=24

# 大模型能力
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.5
